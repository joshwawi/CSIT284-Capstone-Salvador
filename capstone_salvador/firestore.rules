rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function feedbackPath(entryId) {
      return /databases/$(database)/documents/feedback/$(entryId);
    }

    function ratingPath(entryId) {
      return /databases/$(database)/documents/ratings/$(entryId);
    }

    function feedbackMatchesRating(entryId, feedbackData) {
      return existsAfter(ratingPath(entryId))
        && getAfter(ratingPath(entryId)).data.teacherId == feedbackData.teacherId
        && getAfter(ratingPath(entryId)).data.rating == feedbackData.rating;
    }

    function ratingMatchesFeedback(entryId, ratingData) {
      return existsAfter(feedbackPath(entryId))
        && getAfter(feedbackPath(entryId)).data.ownerUid == request.auth.uid
        && getAfter(feedbackPath(entryId)).data.teacherId == ratingData.teacherId
        && getAfter(feedbackPath(entryId)).data.rating == ratingData.rating;
    }

    function validFeedback(data) {
      return data.keys().hasOnly([
          'ownerUid',
          'teacherId',
          'rating',
          'comment',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasAll([
          'ownerUid',
          'teacherId',
          'rating',
          'comment',
          'createdAt',
          'updatedAt'
        ])
        && data.ownerUid is string
        && data.teacherId is string
        && data.rating is int
        && data.rating >= 1
        && data.rating <= 5
        && data.comment is string
        && data.comment.size() <= 500
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function validRating(data) {
      return data.keys().hasOnly(['teacherId', 'rating'])
        && data.keys().hasAll(['teacherId', 'rating'])
        && data.teacherId is string
        && data.rating is int
        && data.rating >= 1
        && data.rating <= 5;
    }

    match /feedback/{entryId} {
      allow read: if signedIn() && resource.data.ownerUid == request.auth.uid;

      allow create: if signedIn()
        && validFeedback(request.resource.data)
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && feedbackMatchesRating(entryId, request.resource.data);

      allow update: if signedIn()
        && resource.data.ownerUid == request.auth.uid
        && validFeedback(request.resource.data)
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time
        && feedbackMatchesRating(entryId, request.resource.data);

      allow delete: if signedIn()
        && resource.data.ownerUid == request.auth.uid
        && !existsAfter(ratingPath(entryId));
    }

    match /ratings/{entryId} {
      allow read: if signedIn();

      allow create: if signedIn()
        && validRating(request.resource.data)
        && ratingMatchesFeedback(entryId, request.resource.data);

      allow update: if signedIn()
        && validRating(request.resource.data)
        && exists(feedbackPath(entryId))
        && get(feedbackPath(entryId)).data.ownerUid == request.auth.uid
        && ratingMatchesFeedback(entryId, request.resource.data);

      allow delete: if signedIn()
        && exists(feedbackPath(entryId))
        && get(feedbackPath(entryId)).data.ownerUid == request.auth.uid
        && !existsAfter(feedbackPath(entryId));
    }
  }
}
